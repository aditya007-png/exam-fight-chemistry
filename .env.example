# Exam Fight Chemistry — Environment Configuration Example
# Copy this file to .env and configure your production environment variables.
# DO NOT commit .env with production credentials to source control.

# Optional: Production Backend REST API URL (e.g. https://exam-fight-chemistry.vercel.app or custom domain)
# If left empty, the frontend uses relative same-origin /api routes (supported by Vercel Serverless Functions)
VITE_API_URL=

# Supabase PostgreSQL Database & Storage Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Application Metadata
VITE_APP_NAME="Exam Fight Chemistry"
VITE_APP_ENV=production
